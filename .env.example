# Mistral AI API Key (Required for Summarization, Extraction & RAG Embeddings)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Optional: Required only for Hinglish / Indic Speech-to-Text)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SST_MODEL=saaras:v2.5

# OpenAI Whisper Model Size (Default: small)
WHISPER_MODEL=small
